# Create a Supabase project, then copy these values from Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: keeps compatibility with a separately hosted API during development.
# VITE_API_BASE_URL=http://localhost:8000

# Server-side only. Set these in Supabase Edge Function secrets; do not add a
# VITE_ prefix or put the API key in a frontend environment variable.
# OPENROUTER_API_KEY=<configure in Supabase secrets>
# OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507

# Local-only ingestion credentials. Keep this file ignored and never expose these
# values in browser variables or commit them.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
